# Supabase: click Connect on the project, copy the connection string, put your database password in it.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOURREF.supabase.co:5432/postgres

# Only for `npm test`: a separate EMPTY database (its name must contain "test"). The tests wipe it.
# TEST_DATABASE_URL=postgresql://localhost:5432/foodhub_test

# Optional order-status notifications (Gmail: use an App Password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=FoodHub <you@gmail.com>
